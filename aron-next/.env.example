# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# CHỈ dùng phía server (Vercel env, KHÔNG đặt tiền tố NEXT_PUBLIC_). Dùng cho form liên hệ/ứng tuyển và script seed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=https://www.aron.com.vn

# Đặt true CHỈ khi website chạy chính thức trên tên miền công ty (cho phép Google lập chỉ mục). Bản xem thử để trống.
NEXT_PUBLIC_ALLOW_INDEX=
