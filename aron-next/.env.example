# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# CHỈ dùng phía server (Vercel env, KHÔNG đặt tiền tố NEXT_PUBLIC_). Dùng cho form liên hệ/ứng tuyển và script seed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=https://www.aron.com.vn

# Đặt true CHỈ khi website chạy chính thức trên tên miền công ty (cho phép Google lập chỉ mục). Bản xem thử để trống.
NEXT_PUBLIC_ALLOW_INDEX=

# --- Gửi email thông báo khi có liên hệ / ứng tuyển (chỉ máy chủ, KHÔNG đặt tiền tố NEXT_PUBLIC_) ---
# Microsoft 365: smtp.office365.com · cổng 587. Hộp thư gửi cần bật "Authenticated SMTP".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARON Website <website@aron.com.vn>"

# --- Chatbot AI "ARON Assistant" (chỉ máy chủ) ---
# Tạm thời dùng Gemini miễn phí: lấy khoá ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Sau này chuyển sang Claude: đặt CHAT_PROVIDER=claude và ANTHROPIC_API_KEY (tính phí theo lượng dùng)
# CHAT_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# Tắt chatbot: CHAT_ENABLED=false · Giới hạn tin nhắn/ngày toàn site (mặc định 400): CHAT_DAILY_CAP=400
