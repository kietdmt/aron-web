
/* v3.5: ARON Assistant — khung chat nổi */
.chat-fab { position: fixed; right: 22px; bottom: 22px; z-index: 70; width: 60px; height: 60px; border-radius: 50%; border: 0; cursor: pointer; color: #2b1d2a; background-image: linear-gradient(135deg, #f3e3a6, #f4c3a0 55%, #f0a092); box-shadow: 0 14px 34px rgba(10, 24, 34, .38); display: grid; place-items: center; transition: transform .2s; }
.chat-fab:hover { transform: translateY(-2px) scale(1.05); }
.chat-fab .material-symbols-outlined { font-size: 28px; }
.chat-panel { position: fixed; right: 22px; bottom: 22px; z-index: 70; width: min(380px, calc(100vw - 24px)); height: min(640px, calc(100vh - 44px)); display: flex; flex-direction: column; background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 30px 80px rgba(8, 20, 30, .42); border: 1px solid #e6dfcf; font-size: .95rem; }
.chat-head { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, #14232f, #1a2f3f 60%, #21404f); color: #fff; }
.chat-head > div { flex: 1; display: flex; flex-direction: column; line-height: 1.25; }
.chat-head small { color: #bfe3df; font-size: .75rem; display: flex; align-items: center; gap: 6px; }
.chat-head small i { width: 8px; height: 8px; border-radius: 50%; background: #5fd0a0; display: inline-block; }
.chat-ava { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: rgba(255, 255, 255, .12); color: #f3e3a6; }
.chat-x { background: transparent; border: 0; color: #fff; cursor: pointer; border-radius: 8px; padding: 4px; display: grid; }
.chat-x:hover { background: rgba(255, 255, 255, .14); }
.chat-body { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: #faf7f0; }
.chat-msg { max-width: 86%; padding: 10px 13px; border-radius: 16px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; animation: chatIn .25s ease-out; }
.chat-msg.bot { align-self: flex-start; background: #fff; color: #1d2b34; border: 1px solid #ece5d4; border-bottom-left-radius: 5px; }
.chat-msg.me { align-self: flex-end; color: #fff; background: linear-gradient(135deg, #47aaa6, #2b8783); border-bottom-right-radius: 5px; }
.chat-msg small { display: block; margin-top: 8px; font-size: .72rem; color: #7b8790; line-height: 1.4; }
.chat-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chat-chips button { border: 1.5px solid #7a5c8e; color: #5b4170; background: #fff; border-radius: 999px; padding: 7px 13px; font: inherit; font-size: .85rem; cursor: pointer; }
.chat-chips button:hover { background: #7a5c8e; color: #fff; }
.chat-typing { display: flex; gap: 5px; padding: 14px; }
.chat-typing i { width: 7px; height: 7px; border-radius: 50%; background: #9aa6ad; animation: chatDot 1.1s infinite ease-in-out; }
.chat-typing i:nth-child(2) { animation-delay: .15s; } .chat-typing i:nth-child(3) { animation-delay: .3s; }
.chat-lead { background: #fff; border: 1px solid #ece5d4; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
.chat-lead input { border: 1px solid #dcd5c4; border-radius: 10px; padding: 9px 11px; font: inherit; }
.chat-lead p { color: #b0322a; margin: 0; font-size: .85rem; }
.chat-lead > div { display: flex; align-items: center; gap: 10px; }
.chat-lead .btn { padding: 9px 18px; font-size: .9rem; }
.chat-link { background: none; border: 0; color: #6b7780; cursor: pointer; font: inherit; text-decoration: underline; }
.chat-leadbtn { margin: 0 14px 8px; align-self: flex-start; background: none; border: 0; color: #7a5c8e; font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; padding: 2px 0; text-decoration: underline; }
.chat-input { display: flex; gap: 8px; padding: 12px 14px 14px; border-top: 1px solid #eee7d8; background: #fff; }
.chat-input input { flex: 1; border: 1.5px solid #dcd5c4; border-radius: 999px; padding: 10px 15px; font: inherit; min-width: 0; }
.chat-input input:focus { outline: 2px solid #47aaa6; outline-offset: 1px; border-color: transparent; }
.chat-input button { width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; color: #fff; display: grid; place-items: center; background: linear-gradient(135deg, #47aaa6, #2b8783); }
.chat-input button:disabled { opacity: .45; cursor: default; }
@keyframes chatIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes chatDot { 0%, 80%, 100% { transform: translateY(0); opacity: .5; } 40% { transform: translateY(-5px); opacity: 1; } }
@media (max-width: 520px) { .chat-panel { right: 0; bottom: 0; width: 100vw; height: 100dvh; border-radius: 0; } }
@media (prefers-reduced-motion: reduce) { .chat-msg, .chat-typing i, .chat-fab { animation: none; transition: none; } }
